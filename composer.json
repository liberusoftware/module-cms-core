{
    "name": "liberusoftware/module-cms-core",
    "description": "The Liberu CMS kernel: module registry, lifecycle manager, event bus, base module classes, and the module generator.",
    "type": "liberu-module",
    "license": "MIT",
    "homepage": "https://github.com/liberusoftware/module-cms-core",
    "support": {
        "issues": "https://github.com/liberusoftware/module-cms-core/issues",
        "source": "https://github.com/liberusoftware/module-cms-core"
    },
    "version": "0.1.1",
    "require": {
        "php": "^8.5",
        "liberusoftware/module-cms-contracts": "^0.1.1",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Cms\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Cms\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "module-cms-core"
        },
        "laravel": {
            "providers": [
                "Liberu\\Cms\\Core\\CmsCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "liberusoftware/package-testbench": "^1.8",
        "pestphp/pest": "^5.3.3"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-cms-contracts.git"
        }
    ],
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=100"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
